# Telegram bot credential. One credential may serve Claude/Codex/Pi topic routes.
TG_BOT_TOKEN=xxx:yyy

# Optional second Telegram bot/application identity for a separate route namespace.
# TG_CODEX_BOT_TOKEN=xxx:yyy

# 留 0 = setup mode: bot 收到第一条 DM 自动锁定发送者 user_id 并写回此文件
BOSS_USER_ID=0
LOG_LEVEL=INFO

# Runtime V2 delivery rollout: off (legacy), shadow (legacy send + redacted parity
# check), on (V2 delivery only). Start with shadow before enabling on.
TMUXBOT_RUNTIME_V2=shadow

# Missing tmux sessions stay dormant by default and are recreated by the next
# Telegram/Feishu message. Set 1 when every binding must be kept running; the
# same setting is installed by `tmuxbot install-service --now --self-heal`.
TMUXBOT_LIFECYCLE_ENABLED=0
# TMUXBOT_LIFECYCLE_INTERVAL=30

# Provider CLI-only hibernation. The timer starts only while the live TUI is
# explicitly IDLE; IM inactivity is not consulted. Tmux and routes remain.
TMUXBOT_CLI_IDLE_ENABLED=1
TMUXBOT_CLI_IDLE_TIMEOUT=3600
# TMUXBOT_CLI_IDLE_INTERVAL=30

# Web control plane (run separately with `tmuxbot web`). Keep the listener on
# localhost and put an authenticated TLS reverse proxy in front for remote use.
TMUXBOT_WEB_HOST=127.0.0.1
TMUXBOT_WEB_PORT=8765
TMUXBOT_WEB_SECURE_COOKIE=false
# Before first startup, generate a one-time setup token with:
#   openssl rand -hex 32
# Keep this commented placeholder out of production; values shorter than 24
# characters fail startup. Remove the real setting and restart after local setup.
# TMUXBOT_WEB_SETUP_TOKEN=<openssl-rand-hex-32-output>
# TMUXBOT_WEB_PUBLIC_ORIGIN=https://tmuxbot.example.com

# Opt-in managed Claude hooks. Hooks only append to a local spool; tmux remains
# the execution plane and JSONL remains enabled for tools/usage/history.
# TMUXBOT_CLAUDE_HOOKS=true

# Telegram group/topic messages require @bot before they are injected into tmux.
# Private chats are unaffected. Per-token overrides also work, for example:
# TG_CODEX_GROUP_MENTION_ONLY=true or TG_CODEX_BOT_TOKEN_GROUP_MENTION_ONLY=true
# TELEGRAM_GROUP_MENTION_ONLY=false

# AI CLI binary paths (optional but recommended for systemd/tmux deployments).
# Use the native Claude Code binary when possible; this avoids broken npm
# optional-dependency installs and shell PATH differences.
# CLAUDE_BIN=/home/you/.local/bin/claude
# CODEX_BIN=/home/you/.npm-global/bin/codex
# PI_BIN=/home/you/.npm-global/bin/pi

# Privileged Boss DM -> admin tmux route (optional).
# Telegram defaults: channel=telegram, chat_id=BOSS_USER_ID, credential=TG_BOT_TOKEN.
# Feishu requires TMUXBOT_ADMIN_CHAT_ID and checks chat_type=p2p.
# TMUXBOT_ADMIN_ENABLED=1
# TMUXBOT_ADMIN_TMUX=tmuxbot-admin
# TMUXBOT_ADMIN_CLI=pi              # pi / claude_code / codex
# TMUXBOT_ADMIN_CWD=/home/you       # default: runtime account Path.home()
# TMUXBOT_ADMIN_CHANNEL=telegram
# TMUXBOT_ADMIN_CHAT_ID=123456789
# TMUXBOT_ADMIN_CREDENTIAL=TG_BOT_TOKEN

# Attachment directory (optional).
# Telegram/Feishu inbound attachments are downloaded here before @path injection.
# Local paths in AI replies can be uploaded back as native IM image/file messages.
# TMUXBOT_ATTACHMENT_DIR=/tmp/tmuxbot-attachments
# Additional trusted roots for outbound local attachments (':' separated on Linux).
# Existing files outside cwd, the attachment directory, /tmp, and these roots are
# never auto-uploaded.
# TMUXBOT_ATTACHMENT_ALLOWED_ROOTS=/srv/reports:/home/you/shared

# ── 飞书 (可选, 仅 bindings.yaml 有 channel=feishu 的 binding 才需要) ──
# bot_token_env=FEISHU 的 binding 读这组; 多套 app 用 FEISHU2_APP_ID 等前缀区分。
# One tmuxbot.service can host all credentials; do not create one unit per app.
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=yyy
# Boss open_id 白名单 (逗号分隔), 在飞书发任意消息看 bot 日志打印的 open_id
# FEISHU_BOSS_OPEN_IDS=ou_xxx,ou_yyy
# 可选: bot 自己的 open_id, 用于群消息 @bot 唤醒判断
# FEISHU_BOT_OPEN_ID=ou_bot_xxx
# Card JSON 2.0 is enabled by default. Set 0 for legacy-card rollback.
# TMUXBOT_FEISHU_CARD_V2=1
# CardKit streaming requires cardkit:card:write and is default-off for safe rollout.
# TMUXBOT_FEISHU_STREAMING=0
# Per-app overrides are also supported: FEISHU_CARD_V2 / FEISHU_STREAMING.
